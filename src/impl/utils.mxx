module;
#include <SDL3/SDL.h>

module app.utils;
import std;

namespace app {

    using Text = std::string;
    using TextRef = Text const &;

    void showError(SDL_Window *window, TextRef errorMessasge) { }

    auto file_read_full( TextRef path ) -> Text {
        namespace fs = std::filesystem;
        using Size = std::size_t;
        static constexpr Text Empty_Text{ };
        std::ifstream file( path );

        if ( not file.is_open( )) return Empty_Text;

        Size fileSize = fs::file_size( path );
        Text text;
        text.resize_and_overwrite( fileSize, [&file]( char *buff, Size size ){
            file.read( buff, size );

            return file.gcount( );
        });
        file.close();

        return text;
    }

} // namespace `app`
